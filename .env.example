# Supabase (projeto serjohn-crm)
NEXT_PUBLIC_SUPABASE_URL=https://qilzttsbrydwfcwuhmwk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon key>

# Segredo que o site serjohn.pt usa para criar leads (header x-api-key)
LEADS_INTAKE_SECRET=<openssl rand -hex 32 — igual ao guardado em app_secrets.intake>

# Segredo da extensão Chrome (Authorization: Bearer)
IMPORT_API_SECRET=<openssl rand -hex 32 — igual ao guardado em app_secrets.import>

# Google Drive (fluxo de importação mobile.de — igual ao setup antigo do site)
GOOGLE_SERVICE_ACCOUNT_JSON=<JSON completo da service account>
DRIVE_PARENT_FOLDER_ID=<id da pasta-mãe no Drive>

# Webhook do Make para gerar o PDF da proposta (opcional)
MAKE_WEBHOOK_URL=
